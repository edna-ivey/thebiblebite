# Ask Digby email delivery
# Server-only. Required for real Zoho ZeptoMail delivery.

# Secret. Agent-specific Zoho ZeptoMail Send Mail Token.
ZEPTOMAIL_SEND_MAIL_TOKEN="replace-with-zeptomail-agent-send-mail-token"

# Server-only. Private Zoho Mail destination inbox for Ask Digby notifications.
ASK_DIGBY_TO_EMAIL="ask@example.com"

# Server-only. Approved ZeptoMail sender address on a verified sending domain.
ASK_DIGBY_FROM_EMAIL="ask@example.com"
